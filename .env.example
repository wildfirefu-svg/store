# 玄机子 · 八字命理分析 — 环境变量配置
# 复制此文件为 .env 并填写实际值，与 docker-compose.yml 配合使用

# === API Key (多选一) ===
# DeepSeek API Key（推荐，性价比更高）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Anthropic API Key（如使用 Claude）
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Kimi API Key（Moonshot AI）
# KIMI_API_KEY=sk-your-kimi-key-here

# GLM API Key（智谱 AI）
# GLM_API_KEY=your-glm-key-here

# Qwen API Key（通义千问）
# QWEN_API_KEY=sk-your-qwen-key-here

# === 模型配置 ===
# DeepSeek 模型（默认 deepseek-v4-pro）
# DEEPSEEK_MODEL=deepseek-v4-pro

# Anthropic 模型（默认 claude-sonnet-4-6）
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Kimi 模型（默认 kimi-k2.6）
# KIMI_MODEL=kimi-k2.6

# GLM 模型（默认 glm-5.2）
# GLM_MODEL=glm-5.2

# Qwen 模型（默认 qwen3.7-plus）
# QWEN_MODEL=qwen3.7-plus

# DeepSeek 思考模式（disabled/enabled，默认 disabled）
# DEEPSEEK_THINKING=disabled

# 生成温度 0.0-1.0（默认 0.3）
# DEEPSEEK_TEMPERATURE=0.3
# ANTHROPIC_TEMPERATURE=0.3
# BAZI_TEMPERATURE=0.3

# 最大输出 Token 数（默认 16384）
# BAZI_MAX_TOKENS=16384

# === 服务配置 ===
# API 服务端口（默认 8000）
# BAZI_API_PORT=8000

# MCP 服务端口（默认 8001）
# BAZI_MCP_PORT=8001

# 服务鉴权 Key（留空 = 无需认证）
# BAZI_API_KEY=

# CORS 跨域配置（逗号分隔，默认 *）
# BAZI_CORS_ORIGINS=*

# === 限流配置 ===
# 限流规则：空格分隔 "prefix:max_req,window_sec"（默认见下）
# BAZI_RATE_LIMITS=default:120,60 /api/chat/stream:30,60 /api/analyze/pdf:10,60

# 免限流路径（逗号分隔）
# BAZI_RATE_LIMIT_EXEMPT=/static,/api/health,/,/test,/tools,/favicon.ico

# 限流清理间隔（秒，默认 300）
# BAZI_RATE_CLEAN_INTERVAL=300

# === 缓存配置 ===
# 图表缓存大小（默认 128）
# BAZI_CHART_CACHE_SIZE=128

# === 安全配置 ===
# 请求体大小限制（字节，默认 1MB = 1048576）
# BAZI_MAX_BODY_SIZE=1048576

# === 日志配置 ===
# 日志级别：DEBUG/INFO/WARNING/ERROR（默认 INFO）
# BAZI_LOG_LEVEL=INFO

# 日志文件路径（留空 = stderr 输出）
# BAZI_LOG_FILE=

# === AI 重试 ===
# API 调用最大重试次数（默认 2）
# BAZI_API_RETRIES=2

# === 农历转换 ===
# iztro 子进程超时（秒，默认 10）
# BAZI_IZTRO_TIMEOUT=10
