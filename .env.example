# 玄机子 · 八字命理分析 — 环境变量配置
# 复制此文件为 .env 并填写实际值，与 docker-compose.yml 配合使用

# === API Key (二选一) ===
# DeepSeek API Key（推荐，性价比更高）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Anthropic API Key（如使用 Claude）
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# === 可选配置 ===
# DeepSeek 模型（默认 deepseek-v4-pro）
# DEEPSEEK_MODEL=deepseek-v4-pro

# DeepSeek 思考模式（disabled/enabled，默认 disabled）
# DEEPSEEK_THINKING=disabled

# 生成温度 0.0-1.0（默认 0.3，越低越稳定）
# DEEPSEEK_TEMPERATURE=0.3

# 服务鉴权 Key（留空 = 无需认证）
# BAZI_API_KEY=

# CORS 跨域配置（逗号分隔，默认 localhost）
# BAZI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
